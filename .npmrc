# Registry-Zuordnung fuer den eigenen Bereich. Der Zugangsschluessel steht bewusst
# NICHT in dieser Datei: Sie ist versionsverfolgt, und attesta ist oeffentlich.
# npm setzt ${NODE_AUTH_TOKEN} zur Laufzeit ein.
#
# Lokal:  export NODE_AUTH_TOKEN=<Schluessel mit read:packages>
# In der Pipeline: actions/setup-node setzt die Variable aus secrets.
@miloe255:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
